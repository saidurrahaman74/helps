        <receiver
            android:name=".MedicineWidgetProvider"
            android:exported="true"
            android:label="Smart Help Medicine Widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.srcreation.smarthelp.ACTION_TAKE_MEDICINE" />
                <action android:name="com.srcreation.smarthelp.ACTION_REF_WIDGET" />
