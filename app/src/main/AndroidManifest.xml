<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <supports-screens
        android:resizeable="true"
        android:smallScreens="true"
        android:normalScreens="true"
        android:largeScreens="true"
        android:xlargeScreens="true"
        android:anyDensity="true" />

    <application
        android:name=".HelpsApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Helps">

        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.Helps">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".SignupActivity" android:exported="true" />
        <activity android:name=".CaregiverDashboardActivity" android:exported="true" />
        <activity android:name=".LinkPatientActivity" android:exported="false" />
        <activity android:name=".PatientPairingActivity" android:exported="true" />
        <activity android:name=".CaregiverLinkActivity" android:exported="true" />
        <activity android:name=".CaregiverHistoryActivity" android:exported="true" />
        <activity android:name=".CaregiverInstructionsActivity" android:exported="true" />
        <activity android:name=".PatientInstructionsActivity" android:exported="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Helps"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".HomeActivity" />
        <activity android:name=".SeizureActivity" />
        <activity android:name=".AnimalBiteActivity" />
        <activity android:name=".EyeInjuryActivity" />
        <activity android:name=".DrowningActivity" />
        <activity android:name=".AsthmaActivity" />
        <activity android:name=".InsectStingActivity" />
        <activity android:name=".AnaphylaxisActivity" />
        <activity android:name=".FluidTrackerActivity" />
        <activity android:name=".AppointmentActivity" />
        <activity android:name=".PrescriptionScannerActivity" />
        <activity android:name=".NurseHubActivity" />
        <activity android:name=".NurseIdActivity" />
        <activity android:name=".DutyRosterActivity" />

        <activity android:name=".HandoverActivity" />
        <activity android:name=".NurseDoseActivity" />
        <activity android:name=".MedicalAbbreviationActivity" />
        <activity android:name=".IvFluidCalculatorActivity" />
        <activity android:name=".LabValuesActivity" />
        <activity android:name=".NurseGcsActivity" />
        <activity android:name=".NurseApgarActivity" />
        <activity android:name=".NurseBsaActivity" />
        <activity android:name=".NurseOxygenActivity" />
        <activity android:name=".NurseBradenActivity" />
        <activity android:name=".NurseBurnActivity" />
        <activity android:name=".NurseIcuActivity" />
        <activity android:name=".NurseUnitConverterActivity" />
        <activity android:name=".CategoryActivity" />
        <activity android:name=".BmiToolActivity" />
        <activity android:name=".BpTrackerActivity" />
        <activity android:name=".PulseTrackerActivity" />
        <activity android:name=".SpO2TrackerActivity" />
        <activity android:name=".StepCounterActivity" />
        <activity android:name=".InsulinTrackerActivity" />
        <activity android:name=".PeriodTrackerActivity" />
        <activity android:name=".MedicineReminderActivity" />
        <activity android:name=".MedicineAlarmActivity" android:showOnLockScreen="true" android:turnScreenOn="true" android:exported="false" />
        <activity android:name=".VaccineActivity" />
        <activity android:name=".ContentDisplayActivity" />
        <activity android:name=".ProTipsActivity" />
        <activity android:name=".NotificationActivity" />
        <activity android:name=".SearchActivity" />
        <activity android:name=".SettingsActivity" />
        <activity android:name=".WeightChartActivity" />
        <activity android:name=".WomenCareActivity" />
        <activity android:name=".PregnancyActivity" />
        <activity android:name=".GyneProfileActivity" />
        <activity android:name=".HealthDashboardActivity" />
        <activity android:name=".HospitalDetailActivity" />
        <activity android:name=".MedicalVaultActivity" />
        <activity android:name=".MedicalIdActivity" />
        <activity android:name=".NursePainScaleActivity" />
        <activity android:name=".NurseEcgGuideActivity" />
        <activity android:name=".NurseIoActivity" />
        <activity android:name=".NurseDrugDilutionActivity" />
        <activity android:name=".NurseDictionaryActivity" />
        <activity android:name=".MedicalEncyclopediaActivity" />
        <activity
            android:name=".PeriodAlarmActivity"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:exported="false" />
        <activity android:name=".FallTriggerActivity" android:theme="@style/Theme.Helps" android:exported="false" />

        <service
            android:name=".FallDetectionService"
            android:foregroundServiceType="health"
            android:exported="false" />

        <activity android:name=".UnifiedReportActivity" />
        <activity android:name=".WoundsActivity" />
        <activity android:name=".BurnsActivity" />
        <activity android:name=".CprGuideActivity" />
        <activity android:name=".FracturesActivity" />
        <activity android:name=".PoisoningActivity" />
        <activity android:name=".ChokingActivity" />
        <activity android:name=".ElectricShockActivity" />
        <activity android:name=".SnakeBiteActivity" />
        <activity android:name=".HeatStrokeActivity" />
        <activity android:name=".HeatExhaustionActivity" />
        <activity android:name=".FaintingActivity" />
        <activity android:name=".HeartAttackActivity" />
        <activity android:name=".BleedingActivity" />
        <activity android:name=".InsulinCalculatorActivity" />
        <activity android:name=".HealthConnectActivity" />
        <activity android:name=".MedicalQrActivity" />
        <activity android:name=".TempTrackerActivity" />
        <activity android:name=".CaregiverPairingActivity" />
        <activity android:name=".SmartDietActivity" />
        <activity android:name=".FoodScannerActivity" />
        <activity android:name=".ManualFoodEntryActivity" />
        <activity android:name=".DietHistoryActivity" />
        <activity android:name=".MedicationInteractionActivity" />

        <service
            android:name=".HelpsFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>


        <activity-alias
            android:name=".HealthConnectPermissionActivity"
            android:exported="true"
            android:targetActivity=".HealthConnectActivity">
            <intent-filter>
                <action android:name="androidx.health.connect.action.SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity-alias>

        <receiver android:name=".MedicineAlarmReceiver" android:enabled="true" android:exported="false" />
        <receiver android:name=".MedicineActionReceiver" android:enabled="true" android:exported="false" />
        <receiver android:name=".MedicineBootReceiver" android:enabled="true" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.REBOOT" />
            </intent-filter>
        </receiver>
        <receiver android:name=".PeriodAlarmReceiver" android:exported="false" />

        <receiver
            android:name=".MedicineWidgetProvider"
            android:exported="true"
            android:label="Smart Help Medicine Widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.srcreation.smarthelp.ACTION_TAKE_MEDICINE" />
                <action android:name="com.srcreation.smarthelp.ACTION_REFRESH_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_medicine_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.srcreation.smarthelp.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
