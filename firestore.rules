rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is the owner of the user document
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Helper function to check if a caregiver has an active link to the patient
    function isLinkedCaregiver(patientId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/links/$(request.auth.uid)_$(patientId)) &&
        get(/databases/$(database)/documents/links/$(request.auth.uid)_$(patientId)).data.status == 'active';
    }

    // 1. Users collection: A user can read/write only their own users/{uid} document
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // 2 & 3. Patients collection: patients/{pid}/**
    match /patients/{pid} {
      allow read, write: if isOwner(pid) || isLinkedCaregiver(pid);

      match /vitals/{vitalId} {
        allow read, write: if isOwner(pid) || isLinkedCaregiver(pid);
      }

      match /medicines/{medId} {
        allow read, write: if isOwner(pid) || isLinkedCaregiver(pid);

        match /doses/{doseId} {
          allow read, write: if isOwner(pid) || isLinkedCaregiver(pid);
        }
      }

      // Caregivers can create instructions, patient can read/update
      match /instructions/{instructionId} {
        allow read: if isOwner(pid) || isLinkedCaregiver(pid);
        allow create: if isLinkedCaregiver(pid);
        allow update, delete: if isOwner(pid) || isLinkedCaregiver(pid);
      }
    }

    // 4. Pairing Codes: can be created by any signed-in user and read for lookup by code
    match /pairingCodes/{code} {
      allow read, write: if isAuthenticated();
    }

    // 5. Links: caregiver can create link, both patient and caregiver can read/update/delete
    match /links/{linkId} {
      allow create: if isAuthenticated() && request.resource.data.caregiverId == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && (resource.data.caregiverId == request.auth.uid || resource.data.patientId == request.auth.uid);
    }
  }
}
